{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validity Report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "binding",
    "checks",
    "invariants",
    "history",
    "explanation_md",
    "remediation_md"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "status": { "type": "string", "enum": ["blocked", "review_required", "no_findings"] },
    "binding": {
      "type": "object",
      "required": [
        "target_repo",
        "target_repo_name",
        "head_sha",
        "base_sha",
        "base_sha_source",
        "hashes",
        "analyzer_commit",
        "required_checks",
        "completed_checks"
      ],
      "additionalProperties": false,
      "properties": {
        "target_repo":      { "type": "string" },
        "target_repo_name": { "type": "string" },
        "head_sha":         { "type": "string" },
        "base_sha":         { "type": ["string", "null"] },
        "base_sha_source":  { "type": "string" },
        "hashes":           { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "analyzer_commit":  { "type": ["string", "null"] },
        "required_checks":  { "type": "array", "items": { "type": "string" } },
        "completed_checks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["contribution", "summary"],
        "additionalProperties": true,
        "properties": {
          "contribution": { "type": "string", "enum": ["blocked", "review_required", "none"] },
          "summary":      { "type": "string" }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["checked", "not_checked"] }
        }
      }
    },
    "history": {
      "type": "object",
      "required": [
        "confirmed_affected",
        "potentially_affected",
        "confirmed_count",
        "potentially_count",
        "cpu_time_seconds",
        "wall_time_seconds",
        "timing_boundary_values",
        "missing_timing_count"
      ],
      "additionalProperties": false,
      "properties": {
        "confirmed_affected":    { "type": "array", "items": { "type": "string" } },
        "potentially_affected":  { "type": "array", "items": { "type": "string" } },
        "confirmed_count":       { "type": "integer" },
        "potentially_count":     { "type": "integer" },
        "cpu_time_seconds":      { "type": ["number", "null"] },
        "wall_time_seconds":     { "type": ["number", "null"] },
        "timing_boundary_values":{ "type": "array" },
        "missing_timing_count":  { "type": "integer" },
        "truncated":             { "type": "boolean" }
      }
    },
    "explanation_md":  { "type": "string" },
    "remediation_md":  { "type": "string" }
  }
}
